- name: Install HTTPD on Ubuntu
  hosts: web
  become: yes
  gather_facts: yes

  tasks:
    - name: Install Apache
      apt:
        name: apache2
        state: present
        update_cache: yes

    - name: Copy custom index.html
      copy:
        content: "<h1>HTTPD deployed using Ansible on Ubuntu</h1>"
        dest: /var/www/html/index.html

    - name: Ensure Apache is running
      service:
        name: apache2
        state: started
        enabled: yes

